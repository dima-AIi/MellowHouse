@model MellowHouse.Web.Data.Product
<article class="product-card" data-product="@Model.Id">
    <a class="product-photo" href="/Product/@Model.Id" data-product-link><img src="@Model.Image" alt="@Model.Name" width="640" height="426" loading="lazy" /></a>
    <div class="card-copy"><h3><a href="/Product/@Model.Id" data-product-link>@Model.Name</a></h3><p class="card-description">@Model.Description</p><p class="portion">@Model.Portion</p>
    <div class="card-actions"><strong class="card-price" aria-label="Цена @Model.Name: @Model.Price ₽ за порцию">@Model.Price.ToString("N0") ₽</strong><div class="card-controls"><button class="icon-btn favorite" data-favorite="@Model.Id" aria-label="Добавить @Model.Name в избранное" aria-pressed="false"><svg aria-hidden="true"><use href="/images/icons.svg#heart" /></svg></button><div class="add-control" data-product-stepper="@Model.Id"><button class="round-btn product-minus" data-product-delta="-1" data-cart-product="@Model.Id" aria-label="Убрать одну порцию: @Model.Name" hidden>−</button><output class="product-cart-count" data-product-count="@Model.Id" aria-label="В корзине: @Model.Name" aria-live="polite" hidden>0</output><button class="round-btn" data-cart-product="@Model.Id" data-product-delta="1" disabled="@(!Model.Available)" title="@(Model.Available?"Добавить":"Сейчас недоступно")" aria-label="Добавить @Model.Name в корзину">+</button></div></div></div></div>
</article>
