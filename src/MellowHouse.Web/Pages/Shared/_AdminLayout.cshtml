@{var login=ViewData["AdminLogin"] is true;}
<!DOCTYPE html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>@ViewData["Title"] — Mellow House</title><link rel="icon" href="/images/favicon.svg"/><link rel="stylesheet" href="/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="/css/admin.css" asp-append-version="true"/><script type="module" src="/js/admin.js" asp-append-version="true"></script></head><body class="admin-body @(login?"admin-login-body":"")"><a class="skip-link" href="#admin-main">Перейти к содержимому</a>
@if(!login){<aside class="admin-sidebar" id="admin-sidebar"><a class="brand" href="/Admin">Mellow House</a><p class="admin-kicker">Рабочее пространство</p><nav aria-label="Панель управления"><a href="/Admin/Overview" data-admin-nav="overview">◷ <span>Обзор и отчёты</span></a><a href="/Admin/Catalog" data-admin-nav="catalog">▦ <span>Каталог</span></a><a href="/Admin/Orders" data-admin-nav="orders">♧ <span>Заказы</span><small id="admin-new-count"></small></a><a href="/Admin/Clients" data-admin-nav="clients">♙ <span>Гости и команда</span></a><a href="/Admin/Settings" data-admin-nav="settings">⚙ <span>Настройки</span></a></nav><div class="admin-sidebar-bottom"><a href="/">Открыть сайт ↗</a><button class="text-button" data-admin-logout>Выйти</button></div></aside><header class="admin-topbar"><button class="icon-btn" id="admin-menu-toggle" aria-label="Открыть навигацию" aria-controls="admin-sidebar" aria-expanded="false">☰</button><span>Mellow House / <strong id="admin-current-section">Панель управления</strong></span><a href="/" class="admin-site-link">Открыть сайт ↗</a></header>}
<main id="admin-main" class="@(login?"":"admin-main")">@RenderBody()</main><div id="toast" class="toast" role="status" aria-live="polite" hidden><span></span><button type="button" hidden>Отменить</button></div></body></html>
