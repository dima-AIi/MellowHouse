@page
@model IndexModel
@{ ViewData["Title"] = "Кофе, любимая еда и время для себя"; ViewData["BodyClass"] = "home"; }
<div id="brand-intro" class="brand-intro" hidden role="region" aria-label="Добро пожаловать в Mellow House"><div class="brand-intro-content"><img src="/images/mellow-emblem-v4.svg" alt="Фирменный знак Mellow House" width="120" height="120"/><strong>Mellow House</strong><p>Хороший вкус. Тёплые встречи.</p></div></div>
<section class="home-intro">
    <div class="hero"><picture><source media="(max-width: 600px)" srcset="/images/hero-mobile-v28.webp" /><img class="hero-image" src="/images/hero-v28.webp" alt="Кофе, горячий сэндвич, свежий салат и говяжьи медальоны на столе Mellow House" width="1536" height="1024" fetchpriority="high" /></picture>
    <div class="hero-shade"></div><div class="hero-welcome"><h1>Добро пожаловать<br />в Mellow House</h1><p>Кофе, любимая еда и время для себя</p><a class="btn btn-white" href="/Menu">Посмотреть меню</a></div></div>
    <div class="container intro-content"><section class="reveal-message" aria-label="Заказывайте заранее"><h2><span class="reveal-line">Заказывайте заранее.</span><span class="reveal-line">Забирайте без ожидания.</span><span class="reveal-line">Наслаждайтесь Mellow House.</span></h2><p>Выберите кофе, завтрак или любимое блюдо — мы приготовим к вашему приходу.</p></section>
    <section class="popular"><div class="section-heading"><h2>Самые популярные товары</h2><div class="carousel-controls"><button class="outline-round" data-carousel="prev" aria-label="Предыдущие популярные товары">‹</button><button class="outline-round" data-carousel="next" aria-label="Следующие популярные товары">›</button></div></div><div class="popular-track" id="popular-track">@foreach(var p in Model.Popular) { <partial name="_ProductCard" model="p" /> }</div></section></div>
</section>
<section class="container category-section"><h2>Наше меню еды и напитков</h2><div class="photo-categories">
@foreach(var c in Model.Categories){<a class="photo-category" href="/Menu#@c.Id"><img src="@c.Image" alt="" width="640" height="426" loading="lazy"/><h3>@c.Name</h3></a>}
</div></section>
<div class="container home-promos"><section class="coffee-story"><div><h2>Хороший кофе.<br />Свежие ингредиенты.</h2><p>Мы выбираем качественные продукты, готовим с заботой и создаём атмосферу, в которую хочется возвращаться.</p><a href="/About" class="text-link">Больше о Mellow House</a></div><img src="/images/barista.webp" alt="Бариста готовит кофе" width="768" height="512" loading="lazy" /></section><partial name="_AppBanner" /></div>

@inject MellowHouse.Web.Features.SiteService Site
@{var settings=await Site.GetAsync();}
<section class="container value-section"><h2>@settings.MarketingTitle</h2><div class="value-grid"><article><svg aria-hidden="true"><use href="/images/icons.svg?v=20261028-v20#cup"/></svg><h3>Кофе под ваш вкус</h3><p>Ваш объём, любимое молоко и ровно столько сладости, сколько хочется.</p></article><article><svg aria-hidden="true"><use href="/images/icons.svg?v=20261028-v20#heart"/></svg><h3>Любимая еда рядом</h3><p>Горячий сэндвич и чашка кофе — для приятной паузы среди большого дня.</p></article><article><svg aria-hidden="true"><use href="/images/icons.svg?v=20261028-v20#clock"/></svg><h3>В вашем ритме</h3><p>Соберите заказ заранее и выберите удобное время. Больше времени для себя.</p></article></div></section>
<section class="container assistant-section" id="assistant-section"><div class="faq-column"><h2>Есть вопрос?<br/>Давайте разберёмся.</h2><p>Про состав, любимый кофе и удобный способ получить заказ.</p><div class="faq-list">@foreach(var f in settings.Faq){<details><summary>@f.Question</summary><p>@f.Answer</p></details>}</div><p class="faq-help">Не нашли ответ? Напишите помощнику — он подскажет по меню и вашим заказам.</p></div><div class="assistant-card"><header><span class="assistant-avatar">✧</span><div><h3>Помощник Mellow House</h3><p>Выбор блюд и ваши прошлые заказы</p></div></header><div id="chat-messages" class="chat-messages" role="log" aria-live="polite"><div class="chat-message assistant">Здравствуйте! Какую паузу устроим сегодня — с любимым кофе или горячим сэндвичем?</div></div><div class="chat-suggestions"><button data-chat-quick="Подобрать кофе">Подобрать кофе</button><button data-chat-quick="Что перекусить?">Что перекусить?</button><button data-chat-quick="Покажи мой последний заказ">Мой последний заказ</button></div><form id="chat-form" method="post"><label class="sr-only" for="chat-input">Ваш вопрос</label><input id="chat-input" placeholder="Чего хочется сегодня?" maxlength="500" required autocomplete="off"/><button type="submit" aria-label="Отправить вопрос">↑</button></form></div></section>
<dialog id="assistant-product-dialog" class="edit-dialog" aria-labelledby="assistant-product-title"><div class="dialog-heading"><h2 id="assistant-product-title">Настроим ваш заказ</h2><button class="icon-btn" data-close="assistant-product-dialog" aria-label="Закрыть">×</button></div><div id="assistant-product-summary"></div><div id="assistant-product-options" class="configurator"></div><strong id="assistant-product-price" class="large-price"></strong><button id="assistant-product-add" class="btn wide">Добавить в корзину</button><p class="small muted">Добавление не оформляет заказ. Его можно проверить и изменить в корзине.</p></dialog>
