@page
@model MenuModel
@{ ViewData["Title"] = "Меню"; ViewData["BodyClass"] = "menu-page"; }
@inject MellowHouse.Web.Features.SiteService Site
@{var settings=await Site.GetAsync();}
<section class="menu-intro"><div class="menu-intro-copy"><p class="eyebrow">Время для любимого</p><h1>Наше меню</h1><h2>@settings.MenuTitle</h2><p>@settings.MenuText</p><a class="btn" href="#catalog-start" data-go-catalog>Выбрать что-нибудь вкусное</a><a class="text-link" href="/Allergens">Состав и аллергены</a></div><div class="menu-video"><video id="menu-video" autoplay muted loop playsinline preload="metadata" poster="@settings.Poster" tabindex="0" aria-label="Приготовление кофе. Нажмите на видео или пробел для паузы." aria-describedby="video-help"><source src="@settings.Video" type="video/mp4"/></video><span class="video-caption">Маленький ритуал.<br/>Большое удовольствие.</span><span id="video-help" class="video-help">Пауза — нажмите на видео или пробел</span><span id="video-status" class="sr-only" role="status"></span></div></section>
<section class="container allergen-note"><div><strong>Знайте, что в вашей чашке и на тарелке</strong><p>Состав и аллергены указаны в карточках. На общем оборудовании возможны их следы.</p></div><a class="text-link" href="/Allergens">Подробнее об аллергенах</a></section>
<div class="container catalog-search" id="catalog-start"><label for="menu-search">Найдите любимый вкус</label><div class="search-field"><input id="menu-search" type="search" placeholder="Название или ингредиент…" autocomplete="off"/><button id="menu-search-clear" type="button" aria-label="Очистить поиск" hidden>×</button></div><div id="search-results" class="search-results" role="region" aria-label="Результаты поиска" hidden></div><p id="search-status" role="status" class="small muted"></p></div>
<div class="container menu-layout" data-menu-tab="@Model.Tab">
<aside class="category-nav" aria-label="Категории меню">@foreach(var c in Model.Categories){<a href="/Menu#@c.Id" data-category="@c.Id"><span>@c.Name</span><small>@c.Products.Count</small></a>}</aside>
<div class="catalog-main"><div class="catalog-toolbar"><partial name="_MenuTabs" /><div class="fulfilment"><button data-method="pickup"><svg aria-hidden="true"><use href="/images/icons.svg#pin" /></svg>Самовывоз</button><button data-method="delivery"><svg aria-hidden="true"><use href="/images/icons.svg#truck" /></svg>Доставка</button></div></div>
<div id="catalog-sections">@foreach(var c in Model.Categories){<section class="catalog-section" id="@c.Id" data-section="@c.Id"><div class="section-heading"><h2>@c.Name</h2><span>@(c.Products.Count == 0 ? "Скоро" : $"{c.Products.Count} в меню")</span></div>@if(c.Products.Count == 0){<div class="soon-category"><span>Скоро в меню</span><p>Готовим для вас новые вкусы. А пока попробуйте кофе и горячий сэндвич.</p></div>}else{<div class="product-grid">@foreach(var p in c.Products){<partial name="_ProductCard" model="p" />}</div>}</section>}</div>
<section id="special-products" hidden><h2 id="special-title">Рекомендуемое</h2><div class="product-grid" id="special-grid"></div><div class="empty-state" id="favorites-empty" hidden><svg aria-hidden="true"><use href="/images/icons.svg#heart" /></svg><h2>Здесь будут ваши любимые блюда</h2><p>Нажмите на сердечко у товара — он останется под рукой.</p><a class="btn" href="/Menu">Открыть меню</a></div></section>
</div></div><button class="mobile-cart-bar" data-open-cart><svg aria-hidden="true"><use href="/images/icons.svg#bag" /></svg>Корзина · <span data-cart-total>0 ₽</span><span>›</span></button>
