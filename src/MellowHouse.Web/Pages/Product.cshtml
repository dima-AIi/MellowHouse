@page "/Product/{id}"
@model ProductModel
@using System.Text.Json
@{ ViewData["Title"] = Model.Product?.Name ?? "Товар не найден"; ViewData["BodyClass"] = "product-page"; }
@if(Model.Product is null){<div class="container empty-state"><h1>Товар не найден</h1><p>Возможно, он больше не входит в меню. Выберите что-нибудь вкусное в каталоге.</p><a class="btn" href="/Menu">Открыть меню</a></div>}
else{
<div class="container product-container" data-product-detail="@Model.Product.Id"><nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/Menu" data-return-menu>Меню</a><span>/</span><a href="/Menu#@Model.Product.CategoryId">@Model.Product.Category.Name</a><span>/</span><span>@Model.Product.Name</span></nav>
<div class="product-detail"><div class="detail-photo"><img src="@Model.Product.Image" alt="@Model.Product.Name" width="960" height="960" fetchpriority="high" /></div><div class="detail-copy"><div class="title-favorite"><h1>@Model.Product.Name</h1><button class="icon-btn favorite" data-favorite="@Model.Product.Id" aria-label="Добавить @Model.Product.Name в избранное" aria-pressed="false"><svg aria-hidden="true"><use href="/images/icons.svg?v=20261028-v20#heart" /></svg></button></div><p>@Model.Product.Description</p><p class="portion">@Model.Product.Portion</p><div id="product-options" class="configurator" aria-busy="true"><p>Загружаем настройки…</p></div><div class="product-buy"><div class="buy-row"><div class="quantity"><button data-detail-qty="-1" aria-label="Уменьшить количество">−</button><output id="detail-quantity">1</output><button data-detail-qty="1" aria-label="Увеличить количество">+</button></div><strong class="large-price" id="detail-price">@Model.Product.Price ₽</strong></div><button class="btn wide" id="detail-add" disabled="@(!Model.Product.Available)">Добавить в корзину · <span id="detail-button-price">@Model.Product.Price ₽</span></button><output class="detail-cart-count" data-product-count="@Model.Product.Id" data-product-count-label hidden></output></div>
<div class="product-information"><details><summary>Состав и ингредиенты</summary><p>@Model.Product.Ingredients</p><p id="recipe-changes"></p></details><details><summary>Аллергены</summary><p id="product-allergens">@string.Join(", ", Model.Product.View().Allergens)</p><p>На общей кухне возможен перекрёстный контакт. При аллергии уточните состав у сотрудника.</p></details>@if(MellowHouse.Web.Data.NutritionData.Read(Model.Product.Nutrition) is { } facts){<details class="nutrition-details"><summary>КБЖУ и пищевая ценность</summary><div class="accordion-content"><partial name="_Nutrition" model="facts"/><p class="small muted">На базовую порцию @Model.Product.Portion. Другой размер, молоко и добавки меняют пищевую ценность.</p></div></details>}@if(!string.IsNullOrWhiteSpace(Model.Product.Nutrition)&&MellowHouse.Web.Data.NutritionData.Read(Model.Product.Nutrition) is null){<details><summary>Пищевая ценность</summary><p>@Model.Product.Nutrition</p></details>}</div></div></div>
<section class="related"><div class="section-heading"><h2>Вам также может понравиться</h2><a href="/Menu#@Model.Product.CategoryId">Вся категория</a></div>@if(Model.Related.Count == 0){<div class="soon-category"><span>Новые вкусы — скоро</span><p>Рекомендации из этой категории появятся после расширения меню.</p></div>}else{<div class="product-grid related-grid">@foreach(var p in Model.Related){<partial name="_ProductCard" model="p" />}</div>}</section></div>
}
