@page
@{Layout="_AdminLayout"; ViewData["Title"]="Вход в панель";ViewData["AdminLogin"]=true;}
<section class="admin-login"><a href="/" class="brand">Mellow House</a><p class="admin-kicker">Для команды кафе</p><h1>Всё под контролем</h1><p>Войдите, чтобы управлять меню<br />и заботиться о каждом заказе.</p><form id="admin-login-form" method="post"><div class="field"><label for="admin-login">Почта администратора</label><input id="admin-login" name="login" type="email" autocomplete="username" required maxlength="140" /></div><div class="field"><label for="admin-password">Пароль</label><div class="password-wrap"><input id="admin-password" name="password" type="password" autocomplete="current-password" required maxlength="128" /><button type="button" data-toggle-password="admin-password" aria-label="Показать пароль">Показать</button></div></div><p class="form-error" id="admin-login-error" role="alert"></p><button class="btn wide" type="submit">Войти в панель</button></form><a href="/" class="text-link">Вернуться на сайт</a></section>
