FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY Directory.Build.props NuGet.Config ./
COPY src/MellowHouse.Web/MellowHouse.Web.csproj src/MellowHouse.Web/
RUN dotnet restore src/MellowHouse.Web/MellowHouse.Web.csproj
COPY src/MellowHouse.Web/ src/MellowHouse.Web/
RUN dotnet publish src/MellowHouse.Web/MellowHouse.Web.csproj -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
ENV ASPNETCORE_ENVIRONMENT=Production \
    Database__Provider=Postgres \
    ASPNETCORE_HTTP_PORTS=8080 \
    PORT=8080
EXPOSE 8080
COPY --from=build /app/publish .
USER $APP_UID
ENTRYPOINT ["dotnet", "MellowHouse.Web.dll"]
